{
  "agentId": "CONTROLLER-01",
  "role": "controller",
  "group": "Controllers",
  "enabled": true,
  "checkEverySeconds": 10,
  "controller": {
    "url": "",
    "pollEverySeconds": 5,
    "listen": ":8443",
    "databasePath": "appguard.db",
    "agentUpdates": {
      "enabled": true,
      "maxConcurrent": 5
    }
  },
  "applications": [
    {
      "name": "ProcessoLocalDoController",
      "path": "C:\\Apps\\ControllerWorker\\worker.exe",
      "workingDirectory": "C:\\Apps\\ControllerWorker",
      "enabled": true,
      "autoRestart": true,
      "maxRetries": 5,
      "resetAfterSeconds": 300,
      "startupDelaySeconds": 60
    }
  ]
}
